---
// Any image wrapped in this gets the film-grain treatment.
interface Props {
  src: string;
  alt?: string;
  ratio?: string;      // e.g. "4 / 5", "3 / 2"
  eager?: boolean;
  class?: string;
}
const { src, alt = '', ratio = '4 / 5', eager = false, class: className } = Astro.props;
---
<div class:list={['grain', className]} style={`aspect-ratio: ${ratio}`}>
  <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</div>
