---
// "Share to Story": draws a 1080×1920 story image (cover + title) and opens the
// phone's share sheet (Instagram appears there). Also copies the article link so it
// can be pasted into an Instagram link sticker. Desktop: downloads the image instead.
interface Props { title: string; category: string; cover: string; url: string }
const { title, category, cover, url } = Astro.props;
---
<div class="share" data-share data-title={title} data-category={category} data-cover={cover} data-url={url}>
  <span class="eyebrow label">Share</span>
  <div class="actions">
    <button type="button" class="eyebrow" data-story>Instagram Story</button>
    <span class="sep" aria-hidden="true">·</span>
    <button type="button" class="eyebrow" data-copy>Copy link</button>
  </div>
  <p class="note" data-note aria-live="polite"></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-share]');
  if (root) {
    const { title = '', category = '', cover = '', url = '' } = root.dataset;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const say = (msg: string) => { note.textContent = msg; };

    const copyLink = async () => {
      try { await navigator.clipboard.writeText(url); return true; } catch { return false; }
    };

    const loadImg = (src: string) =>
      new Promise<HTMLImageElement>((res, rej) => {
        const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src;
      });

    // Draw image to fill a box (like object-fit: cover)
    function drawCover(ctx: CanvasRenderingContext2D, img: HTMLImageElement, x: number, y: number, w: number, h: number) {
      const s = Math.max(w / img.width, h / img.height);
      const sw = w / s, sh = h / s;
      ctx.drawImage(img, (img.width - sw) / 2, (img.height - sh) / 2, sw, sh, x, y, w, h);
    }

    function wrap(ctx: CanvasRenderingContext2D, text: string, maxW: number) {
      const words = text.split(' '); const lines: string[] = []; let line = '';
      for (const w of words) {
        const test = line ? `${line} ${w}` : w;
        if (ctx.measureText(test).width > maxW && line) { lines.push(line); line = w; } else line = test;
      }
      if (line) lines.push(line);
      return lines;
    }

    async function makeStory(): Promise<Blob> {
      await Promise.all([
        document.fonts.load('300 92px "Cormorant Garamond"'),
        document.fonts.load('400 30px "Jost"'),
      ]).catch(() => {});
      const [paper, img, logo] = await Promise.all([
        loadImg('/textures/paper.jpg'), loadImg(cover), loadImg('/logo-transparent.png'),
      ]);
      // Film grain drawn in code. (An SVG texture makes Safari refuse to export the canvas.)
      const grain = document.createElement('canvas');
      grain.width = grain.height = 256;
      const gctx = grain.getContext('2d')!;
      const gd = gctx.createImageData(256, 256);
      for (let i = 0; i < gd.data.length; i += 4) {
        const v = 90 + Math.random() * 110;
        gd.data[i] = gd.data[i + 1] = gd.data[i + 2] = v; gd.data[i + 3] = 255;
      }
      gctx.putImageData(gd, 0, 0);
      const W = 1080, H = 1920, c = document.createElement('canvas');
      c.width = W; c.height = H;
      const ctx = c.getContext('2d')!;

      // paper background
      ctx.fillStyle = '#f4efe6'; ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 0.45; drawCover(ctx, paper, 0, 0, W, H); ctx.globalAlpha = 1;

      // logo
      const lh = 110, lw = (logo.width / logo.height) * lh;
      ctx.drawImage(logo, (W - lw) / 2, 150, lw, lh);

      // cover with grain + soft vignette
      const cx = 120, cy = 330, cw = 840, ch = 1050;
      ctx.filter = 'saturate(0.82) contrast(1.04) sepia(0.08)';
      drawCover(ctx, img, cx, cy, cw, ch);
      ctx.filter = 'none';
      ctx.save(); ctx.beginPath(); ctx.rect(cx, cy, cw, ch); ctx.clip();
      ctx.globalCompositeOperation = 'overlay'; ctx.globalAlpha = 0.5;
      const pat = ctx.createPattern(grain, 'repeat'); if (pat) { ctx.fillStyle = pat; ctx.fillRect(cx, cy, cw, ch); }
      ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
      const v = ctx.createRadialGradient(cx + cw / 2, cy + ch / 2, ch * 0.3, cx + cw / 2, cy + ch / 2, ch * 0.75);
      v.addColorStop(0, 'rgba(30,22,16,0)'); v.addColorStop(1, 'rgba(30,22,16,0.22)');
      ctx.fillStyle = v; ctx.fillRect(cx, cy, cw, ch);
      ctx.restore();

      // category
      ctx.textAlign = 'center'; ctx.fillStyle = '#6b625a';
      ctx.font = '400 26px Jost, Helvetica, sans-serif';
      ctx.letterSpacing = '7px';
      ctx.fillText(category.toUpperCase(), W / 2, 1470);
      ctx.letterSpacing = '0px';

      // title
      ctx.fillStyle = '#2a2521'; ctx.font = '300 84px "Cormorant Garamond", Georgia, serif';
      const lines = wrap(ctx, title, 880).slice(0, 3);
      lines.forEach((l, i) => ctx.fillText(l, W / 2, 1580 + i * 92));

      // site
      ctx.fillStyle = '#6b625a'; ctx.font = '400 24px Jost, Helvetica, sans-serif';
      ctx.letterSpacing = '6px';
      ctx.fillText('THEFINERTHINGSJOURNAL.COM', W / 2, 1830);

      return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej()), 'image/jpeg', 0.92));
    }

    // Build the story image ahead of time: phones only allow the share sheet
    // (and clipboard) immediately after a tap, so nothing slow can run on click.
    let ready: Promise<File> | null = null;
    let file: File | null = null;
    const prepare = () => {
      if (!ready) ready = makeStory().then((b) => (file = new File([b], 'tftj-story.jpg', { type: 'image/jpeg' })));
      return ready;
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { prepare().catch(() => {}); io.disconnect(); }
    }, { rootMargin: '800px' });
    io.observe(root);

    const storyBtn = root.querySelector<HTMLButtonElement>('[data-story]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    storyBtn.addEventListener('pointerdown', () => { prepare().catch(() => {}); });

    const flash = (btn: HTMLButtonElement, text: string) => {
      const orig = btn.dataset.label ?? (btn.dataset.label = btn.textContent ?? '');
      btn.textContent = text;
      setTimeout(() => { btn.textContent = orig; }, 2200);
    };

    // Fallback: show the image so it can be saved with a long-press
    const showImage = (f: File) => {
      const wrap = document.createElement('div');
      wrap.className = 'story-preview';
      const img = new Image(); img.src = URL.createObjectURL(f); img.alt = 'Story image';
      const hint = document.createElement('p'); hint.textContent = 'Press and hold the image to save it, then share it to your story.';
      const close = document.createElement('button'); close.type = 'button'; close.textContent = 'Close';
      close.onclick = () => wrap.remove();
      wrap.append(img, hint, close); document.body.appendChild(wrap);
    };

    storyBtn.addEventListener('click', () => {
      // copy the link now, while the tap still counts
      navigator.clipboard?.writeText(url).catch(() => {});
      if (!file) {
        say('Preparing your story image… tap again in a moment.');
        prepare().then(() => say('Ready. Tap “Instagram Story” again.')).catch((e) => { console.error(e); say('Could not create the story image.'); });
        return;
      }
      const f = file;
      // Phones and tablets have Instagram in their share sheet; desktops don't,
      // so there we just download the image (and the link is already copied).
      const isTouch = window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 1;
      if (isTouch && navigator.canShare?.({ files: [f] })) {
        navigator.share({ files: [f] })
          .then(() => say('Link copied. In Instagram, add a Link sticker and paste it.'))
          .catch((e) => { if (e?.name !== 'AbortError') { showImage(f); say(''); } });
      } else {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(f); a.download = 'tftj-story.jpg';
        document.body.appendChild(a); a.click(); a.remove();
        say('Story image downloaded and link copied. To post it, move the image to your phone (AirDrop or email), then add it to your Instagram story.');
      }
    });

    copyBtn.addEventListener('click', () => {
      const done = () => { flash(copyBtn, 'Copied ✓'); say('Link copied.'); };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(() => say(url));
      } else {
        const t = document.createElement('textarea'); t.value = url; document.body.appendChild(t);
        t.select(); const ok = document.execCommand('copy'); t.remove();
        ok ? done() : say(url);
      }
    });
  }
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 3rem auto 0;
    padding: 1.4rem var(--gutter);
  }
  .label { color: var(--ink-faint); }
  .actions { display: flex; gap: 0.9rem; align-items: baseline; }
  .sep { color: var(--ink-faint); }
  button {
    appearance: none; background: none; border: 0; padding: 0.3rem 0; cursor: pointer;
    color: var(--ink); border-bottom: 1px solid var(--ink-faint);
    transition: border-color 0.3s;
  }
  button:hover { border-color: var(--ink); }
  :global(.story-preview) {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(244, 239, 230, 0.97);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem; padding: 1.5rem;
  }
  :global(.story-preview img) { max-height: 72vh; width: auto; box-shadow: 0 10px 40px rgba(0,0,0,.15); }
  :global(.story-preview p) { margin: 0; font-family: var(--serif); font-style: italic; text-align: center; color: var(--ink-soft); }
  :global(.story-preview button) {
    font-family: var(--sans); font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase;
    background: none; border: 0; border-bottom: 1px solid var(--ink); padding: 0.3rem 0; color: var(--ink); cursor: pointer;
  }
  .note {
    flex-basis: 100%;
    margin: 0;
    min-height: 1.4em;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
  }
</style>
