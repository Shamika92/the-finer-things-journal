---
// Like button: a heart readers can tap. No public count; each like is sent to
// Google Analytics as a "like" event (see Reports > Engagement > Events).
---
<div class="like">
  <button type="button" data-like aria-pressed="false" aria-label="Like this post">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.7 8 3.6 5 6.8 5c1.9 0 3.4 1 5.2 3 1.8-2 3.3-3 5.2-3 3.2 0 5.1 3 4 6.2-1.7 4.7-9.2 9.3-9.2 9.3z" /></svg>
    <span class="eyebrow" data-like-text>Like this post</span>
  </button>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-like]');
  if (btn) {
    const text = btn.querySelector<HTMLElement>('[data-like-text]')!;
    const key = 'liked:' + location.pathname;
    const read = () => { try { return localStorage.getItem(key) === '1'; } catch { return false; } };
    const write = (v: boolean) => { try { v ? localStorage.setItem(key, '1') : localStorage.removeItem(key); } catch {} };
    const paint = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      text.textContent = on ? 'Thank you' : 'Like this post';
    };
    paint(read());
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      paint(on); write(on);
      if (on) (window as any).gtag?.('event', 'like', { page_path: location.pathname });
    });
  }
</script>

<style>
  .like { display: flex; justify-content: center; padding: 2.5rem var(--gutter) 0; }
  button {
    appearance: none; background: none; border: 0; cursor: pointer; padding: 0.4rem 0.2rem;
    display: inline-flex; align-items: center; gap: 0.7rem; color: var(--ink);
  }
  svg { fill: none; stroke: currentColor; stroke-width: 1.4; transition: fill 0.25s, transform 0.25s, color 0.25s; }
  button:hover svg { transform: scale(1.08); }
  button[aria-pressed='true'] svg { fill: var(--accent); stroke: var(--accent); }
</style>
