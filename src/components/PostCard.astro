---
import GrainImage from './GrainImage.astro';
import { categoryLabel } from '../data/site';
import { formatDate } from '../data/posts';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'journal'>; index?: number }
const { post, index = 0 } = Astro.props;
const { title, dek, category, date, cover, coverAlt } = post.data;
---
<article class="card reveal" data-category={category} style={`animation-delay:${0.08 * index + 0.1}s`}>
  <a href={`/journal/${post.id}`}>
    <GrainImage src={cover} alt={coverAlt} />
    <div class="meta">
      <span class="eyebrow">{categoryLabel(category)}</span>
      <span class="dot" aria-hidden="true">·</span>
      <time class="eyebrow" datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h2>{title}</h2>
    <p>{dek}</p>
  </a>
</article>

<style>
  .card a { display: block; }
  .card :global(.grain img) { will-change: transform; }
  .card a:hover :global(.grain img) { transform: scale(1.035); }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.35rem;
  }
  .meta .eyebrow { font-size: 0.6rem; }
  .dot { color: var(--ink-faint); }
  h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.2vw, 1.65rem);
    line-height: 1.18;
    margin: 0.6rem 0 0.55rem;
    transition: color 0.3s;
  }
  .card a:hover h2 { color: var(--accent); }
  p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
